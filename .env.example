# Environment Configuration
NODE_ENV=development

# Database
DATABASE_PATH=./database/prices.db

# Scraping Schedule (cron format: minute hour day month dayofweek)
# Default: 3:30 AM EST daily
SCRAPE_SCHEDULE=30 3 * * *

# Timezone
TIMEZONE=America/New_York

# Crawler Settings
HEADLESS=true
MAX_RETRIES=3
TIMEOUT_SECONDS=60

# Alerts (optional)
ALERT_EMAIL=
SLACK_WEBHOOK_URL=

# Logging
LOG_LEVEL=info
