{
  "name": "rackscrape",
  "version": "1.0.0",
  "description": "Automated scraper for Petro-Canada rack prices",
  "type": "module",
  "scripts": {
    "start": "tsx src/main.ts",
    "scrape": "tsx src/main.ts",
    "schedule": "tsx src/scheduler.ts",
    "api": "tsx src/server.ts",
    "dev:api": "tsx watch src/server.ts",
    "build:web": "TAILWIND_CONFIG=tailwind.config.cjs vite build --config web/vite.config.ts",
    "dev:web": "vite dev --config web/vite.config.ts",
    "export": "tsx src/scripts/export.ts",
    "query": "tsx src/scripts/query.ts",
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "test": "tsx src/scripts/test.ts"
  },
  "keywords": [
    "crawlee",
    "playwright",
    "scraper",
    "petro-canada",
    "fuel-prices"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@radix-ui/react-slot": "^1.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "cors": "^2.8.5",
    "crawlee": "^3.7.0",
    "date-fns": "^3.6.0",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "lucide-react": "^0.300.0",
    "multer": "^2.0.2",
    "node-cron": "^3.0.3",
    "playwright": "^1.40.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.10.4",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "tailwind-merge": "^2.2.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^5.1.6"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
